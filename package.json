{
  "name": "psicologia",
  "private": true,
  "version": "0.0.0",
  "workspaces": [
    "apps/web",
    "apps/api"
  ],
  "engines": {
    "node": ">=24.21.0 <25",
    "npm": ">=11 <12"
  },
  "packageManager": "npm@11.13.0",
  "scripts": {
    "dev:web": "npm run dev --workspace @psicologia/web",
    "dev:api": "npm run dev --workspace @psicologia/api",
    "preview:web": "npm run preview --workspace @psicologia/web",
    "start:api": "npm run start --workspace @psicologia/api",
    "typecheck": "npm run typecheck --workspaces",
    "build": "npm run build --workspaces",
    "test": "npm run test --workspaces",
    "lint": "eslint . --max-warnings 0",
    "format:check": "prettier --check .",
    "format:write": "prettier --write .",
    "check": "npm run lint && npm run format:check && npm run typecheck && npm test && npm run build",
    "test:database": "npm run build --workspace @psicologia/api && node scripts/database-tests/run.mjs",
    "db:check": "npm run db:check --workspace @psicologia/api"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "24.19.2",
    "eslint": "10.12.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.7",
    "globals": "17.13.0",
    "prettier": "3.9.10",
    "supabase": "2.121.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.2",
    "vitest": "5.0.4"
  }
}
