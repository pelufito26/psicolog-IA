# Configurar solo localmente. Nunca usar la contraseña del chat.
DATABASE_URL=
# Opcional: ruta al certificado CA del proyecto, obtenido de Supabase.
DATABASE_CA_FILE=
# Acceso real: preparar localmente, habilitar solo después de T7 autorizado.
# Sin configuración completa el servidor normal deniega acceso a pacientes.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
AUTH_REDIRECT_URL=http://127.0.0.1:5173/
# Secreto aleatorio de al menos 32 caracteres; nunca pegar en el chat.
AUTH_SECRET=
AUTH_MAIL_MODE=
RESEND_API_KEY=
AUTH_FROM=
# DEV_PROFESIONAL_ID y DEV_PATIENT_REGISTRATION ya no habilitan el servidor.
